<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AshkanAQMS</RootNamespace>
    <AssemblyName>AshkanAQMS</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon />
    <AssemblyVersion>17.0.0.0</AssemblyVersion>
    <FileVersion>17.0.0.0</FileVersion>
    <Nullable>disable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>

  <!-- DPAPI support for secure analyzer credentials on .NET Framework 4.8. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Original SadraAQMS analyzer sources supplied by the user are intentionally retained
         as engineering migration references. They depend on the legacy SadraAQMS runtime and
         are excluded from compilation until adapted/tested against physical hardware. -->
    <Compile Remove="LegacyAnalyzerSources\**\*.cs" />
    <None Include="LegacyAnalyzerSources\**\*.cs" />
  </ItemGroup>
</Project>
